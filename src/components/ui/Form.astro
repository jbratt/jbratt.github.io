---
import type { Form as Props } from '~/types';
import Button from '~/components/ui/Button.astro';

const {
  inputs,
  hiddenInputs,
  textarea,
  disclaimer,
  recaptchaSiteKey,
  button = 'Contact us',
  description = '',
  action,
  method = 'post',
} = Astro.props;

const textareaId = textarea?.name || 'textarea';
---

<form action={action} method={action ? method : undefined}>
  {hiddenInputs && hiddenInputs.map(({ name, value, id }) => <input type="hidden" name={name} value={value} id={id} />)}

  {
    inputs &&
      inputs.map(
        ({ type = 'text', name, label = '', autocomplete = 'on', placeholder = '', maxlength, required = false }) =>
          name && (
            <div class="mb-6">
              {label && (
                <label for={name} class="block text-sm font-medium mb-1.5">
                  {label}
                </label>
              )}
              <input
                type={type}
                name={name}
                id={name}
                autocomplete={autocomplete}
                placeholder={placeholder}
                maxlength={maxlength}
                required={required}
                class="py-3 px-4 block w-full text-md rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-slate-900"
              />
            </div>
          )
      )
  }

  {
    textarea && (
      <div>
        <label for={textareaId} class="block text-sm font-medium mb-1.5">
          {textarea.label}
        </label>
        <textarea
          id={textareaId}
          name={textarea.name ? textarea.name : 'message'}
          rows={textarea.rows ? textarea.rows : 4}
          placeholder={textarea.placeholder}
          required={textarea.required}
          class="py-3 px-4 block w-full text-md rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-slate-900"
        />
      </div>
    )
  }

  {
    disclaimer && (
      <div class="mt-3 flex items-start">
        <div class="flex mt-0.5">
          <input
            id="disclaimer"
            name="disclaimer"
            type="checkbox"
            class="cursor-pointer mt-1 py-3 px-4 block w-full text-md rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-slate-900"
          />
        </div>
        <div class="ml-3">
          <label for="disclaimer" class="cursor-pointer select-none text-sm text-gray-600 dark:text-gray-400">
            {disclaimer.label}
          </label>
        </div>
      </div>
    )
  }

  {
    recaptchaSiteKey && (
      <div class="mt-6">
        <div class="g-recaptcha" data-sitekey={recaptchaSiteKey} />
      </div>
    )
  }

  {
    button && (
      <div class="mt-8 grid">
        <Button variant="primary" type="submit" name="submit">
          {button}
        </Button>
      </div>
    )
  }

  {
    description && (
      <div class="mt-3 text-center">
        <p class="text-sm text-gray-600 dark:text-gray-400">{description}</p>
      </div>
    )
  }
</form>

<script>
  let timestampIntervalId: number | undefined;

  const updateCaptchaTimestamp = () => {
    const captchaInput = document.getElementsByName('captcha_settings')[0];
    if (!(captchaInput instanceof HTMLInputElement)) return;
    const response = document.getElementById('g-recaptcha-response');
    const responseValue =
      response instanceof HTMLTextAreaElement || response instanceof HTMLInputElement ? response.value : '';
    if (response === null || responseValue.trim() === '') {
      try {
        const elems = JSON.parse(captchaInput.value);
        elems['ts'] = JSON.stringify(new Date().getTime());
        captchaInput.value = JSON.stringify(elems);
      } catch {
        // Ignore malformed JSON
      }
    }
  };

  const renderRecaptchaIfNeeded = () => {
    const container = document.querySelector<HTMLElement>('.g-recaptcha');
    if (!container || container.childElementCount > 0) return;

    const sitekey = container.dataset.sitekey;
    if (!sitekey) return;

    const grecaptcha = (
      window as Window & { grecaptcha?: { render?: (el: HTMLElement, opts: { sitekey: string }) => void } }
    ).grecaptcha;
    if (grecaptcha && typeof grecaptcha.render === 'function') {
      grecaptcha.render(container, { sitekey });
      return;
    }

    if (!document.querySelector('script[src*="google.com/recaptcha/api.js"]')) {
      const script = document.createElement('script');
      script.src = 'https://www.google.com/recaptcha/api.js';
      script.async = true;
      script.defer = true;
      document.head.appendChild(script);
    }
  };

  const setupSalesforceWebToLead = () => {
    if (timestampIntervalId !== undefined) {
      window.clearInterval(timestampIntervalId);
      timestampIntervalId = undefined;
    }

    const captchaInput = document.getElementsByName('captcha_settings')[0];
    if (captchaInput) {
      updateCaptchaTimestamp();
      timestampIntervalId = window.setInterval(updateCaptchaTimestamp, 500);
    }

    renderRecaptchaIfNeeded();
  };

  document.addEventListener('astro:page-load', setupSalesforceWebToLead);
  setupSalesforceWebToLead();
</script>
