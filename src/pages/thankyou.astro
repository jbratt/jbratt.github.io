---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';

const metadata = {
  title: 'Request Submitted',
  description: 'Thank you for your interest in Practical Algorithm.',
  robots: {
    index: false,
    follow: false,
  },
};
---

<Layout metadata={metadata}>
  <HeroText
    tagline="Thank You"
    title="Request Submitted"
    subtitle="Thank you for your interest in Practical Algorithm. We will be in contact with you soon."
    callToAction={{
      variant: 'primary',
      text: 'Back to Home',
      href: '/',
    }}
  />
</Layout>
